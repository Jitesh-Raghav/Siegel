# Public site origin, used for canonical URLs, hreflang, sitemap and OG images
NEXT_PUBLIC_SITE_URL=https://siegel.example

# Supabase (server-only; the waitlist route uses the service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PostHog (cookieless, proxied via /ingest). Leave empty to disable analytics.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional, defaults to the EU cloud
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_ASSETS_HOST=https://eu-assets.i.posthog.com
